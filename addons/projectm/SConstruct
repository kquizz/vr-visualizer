#!/usr/bin/env python
import os

env = SConscript("godot-cpp/SConstruct")

# projectM v4 (built from source)
PROJECTM_V4_ROOT = os.path.expanduser("~/Code/games/projectm-v4")
PROJECTM_V4_INSTALL = os.path.join(PROJECTM_V4_ROOT, "install")
PROJECTM_V4_SRC = os.path.join(PROJECTM_V4_ROOT, "src", "libprojectM")
PROJECTM_V4_BUILD = os.path.join(PROJECTM_V4_ROOT, "build")

# Public v4 C API headers
env.Append(CPPPATH=[os.path.join(PROJECTM_V4_INSTALL, "include")])

# Internal v4 headers (for parameter access shim)
env.Append(CPPPATH=[
    PROJECTM_V4_SRC,                                        # ProjectM.hpp, ProjectMCWrapper.hpp
    os.path.join(PROJECTM_V4_SRC, "MilkdropPreset"),       # PresetState.hpp, PerFrameContext.hpp
    os.path.join(PROJECTM_V4_ROOT, "vendor", "projectm-eval"),             # parent dir for <projectm-eval/api/projectm-eval.h>
    os.path.join(PROJECTM_V4_ROOT, "vendor", "projectm-eval", "projectm-eval", "api"),  # for <projectm-eval.h>
    os.path.join(PROJECTM_V4_ROOT, "vendor"),                # GLM headers (vendor/glm/...)
    os.path.join(PROJECTM_V4_BUILD, "include"),              # config.h generated by cmake
    os.path.join(PROJECTM_V4_BUILD, "src", "api", "include"),  # generated projectM_export.h
])

# Static library
env.Append(LIBPATH=[os.path.join(PROJECTM_V4_INSTALL, "lib")])
env.Append(LIBS=["projectM-4"])

# projectm-eval static lib (built alongside v4)
env.Append(LIBPATH=[os.path.join(PROJECTM_V4_BUILD, "vendor", "projectm-eval", "projectm-eval")])
env.Append(LIBS=["projectM_eval"])

# SDL2 (still needed for offscreen GL context)
env.Append(CPPPATH=["/opt/homebrew/include/", "/opt/homebrew/include/SDL2/"])
env.Append(LIBPATH=["/opt/homebrew/lib/"])
env.Append(LIBS=["SDL2"])

# macOS frameworks
if env["platform"] == "macos":
    env.Append(LINKFLAGS=[
        "-framework", "OpenGL",
        "-framework", "CoreFoundation",
    ])

# Extension source files
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# Output library
library = env.SharedLibrary(
    "bin/libprojectm_gdext{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
