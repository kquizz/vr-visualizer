#!/usr/bin/env python
import os

env = SConscript("godot-cpp/SConstruct")

# projectM + SDL2 include/lib paths (Homebrew on macOS)
env.Append(CPPPATH=["/opt/homebrew/include/", "/opt/homebrew/include/SDL2/"])
env.Append(LIBPATH=["/opt/homebrew/lib/"])
env.Append(LIBS=["projectM", "SDL2"])

# macOS OpenGL framework
if env["platform"] == "macos":
    env.Append(LINKFLAGS=["-framework", "OpenGL"])

# Extension source files
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# Output library
library = env.SharedLibrary(
    "bin/libprojectm_gdext{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
